{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "libreOSINT",
  "version": "0.1.0",
  "identifier": "dev.libreosint.app",
  "build": {
    "beforeDevCommand": "npm run start -- --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/libre-osint/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "libreOSINT",
        "dragDropEnabled": false,
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../transforms/": "transforms/"
    }
  }
}
