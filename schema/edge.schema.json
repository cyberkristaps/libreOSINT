{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libreosint.dev/schema/edge.schema.json",
  "title": "Edge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source_id",
    "target_id",
    "label",
    "transform_source",
    "timestamp"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source_id": {
      "type": "string",
      "format": "uuid"
    },
    "target_id": {
      "type": "string",
      "format": "uuid"
    },
    "label": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "transform_source": {
      "type": "string",
      "description": "Transform id, or 'manual'"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
