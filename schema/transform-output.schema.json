{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libreosint.dev/schema/transform-output.schema.json",
  "title": "TransformResponse",
  "type": "object",
  "required": [
    "contract_version",
    "entities"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "type",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "not": {
              "const": "$input"
            }
          },
          "type": {
            "$ref": "entity.schema.json#/$defs/EntityType"
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "properties": {
            "type": "object"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "description": "An entity ref or '$input'"
          },
          "target": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "level",
          "text"
        ],
        "properties": {
          "level": {
            "enum": [
              "debug",
              "info",
              "warn",
              "error"
            ]
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "data": {
      "type": "object",
      "description": "Free-form structured results for consumers such as the AI investigator; not ingested into the graph."
    }
  }
}
